---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { shortDate } from '../../lib/dates';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing" current="writing">
  <h1>Writing</h1>
  <p class="lede">Notes from the group, and pieces by guests.</p>
  <ul class="rows">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}/`}>
          <span class="when">{shortDate(post.data.date)}</span>
          <span class="title">{post.data.title} <span class="by">· {post.data.author}</span></span>
        </a>
      </li>
    ))}
  </ul>
</Base>
