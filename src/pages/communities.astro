---
import Base from '../layouts/Base.astro';
import { whatsappCommunity } from '../lib/communities';
---
<Base title="Communities" current="communities">
  <h1>Communities</h1>
  <p class="lede">Places to keep talking between gatherings in Ahmedabad and Gandhinagar.</p>
  <ul class="lines">
    <li id="whatsapp">
      <a href={whatsappCommunity}><strong>WhatsApp</strong></a>
      <span class="by"> · Join the community</span>
    </li>
    <li id="discord">
      <strong>Discord</strong>
      <span class="by"> · The server link will be added when it exists.</span>
    </li>
  </ul>
</Base>
