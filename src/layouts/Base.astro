---
import '../styles/site.css';

interface Props {
  title: string;
  current?: 'events' | 'writing' | 'communities';
}

const { title, current } = Astro.props;
const pageTitle = title === 'Chips and Chai' ? title : `${title} · Chips and Chai`;
---
<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="frame">
      <header class="site-header">
        <a class="mark" href="/">Chips and Chai</a>
        <nav aria-label="Primary">
          <a href="/events/" aria-current={current === 'events' ? 'page' : undefined}>Events</a>
          <!-- <a href="/writing/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a> -->
          <a href="/communities/" aria-current={current === 'communities' ? 'page' : undefined}>Communities</a>
        </nav>
      </header>
      <slot />
      <footer>
        chipsandchai.in
        <span class="by"> · Maintained by Manu Awasthi · <a href="mailto:manu.awasthi@gmail.com">manu.awasthi@gmail.com</a> · <a href="https://manuawasthi.in/">manuawasthi.in</a></span>
      </footer>
    </div>
  </body>
</html>
